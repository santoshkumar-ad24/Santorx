        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-Q1SH5LZCTH');
    </script>
    <meta name="yandex-verification" content="dad153b32c9fed72" />
    <script type="application/ld+json">
{
"@context": "https://schema.org",
"@type": "WebSite",
"name": "Saniova"
}
</script>
    <script type="text/javascript">
        (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "w0boasx8gf");
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="BookMark - Saniova. Learn how we protect your data while exploring AI, AGI, and future technology insights.">
    <meta name="keywords" content="BookMark, Data Protection, AI Technology, Saniova, AGI, Future Tech">
    <meta property="og:site_name" content="Saniova" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <title>Check BookMark | Saniova</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="/stylesheet/hamburger-menu.css">
    <link rel="stylesheet" href="/stylesheet/blog-cards.css">
</head>

<body>
    <header>
        <nav>
            <div class="logo">
                <img src="/image/logo.png" alt="logo-image" class="logo-image">
                <a href="/">
                    <h2>Saniova</h2>
                </a>
            </div>
            <input type="checkbox" id="menu-toggle" style="display: none;">
            <label for="menu-toggle" class="menu-backdrop" aria-hidden="true"></label>
            <label for="menu-toggle" class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div class="nav-link menu">
                <a href="/">Home</a>
                <a href="/blog">Blog</a>
                <a href="/about">About</a>
                <a href="/privacy-policy">Privacy</a>
                <a href="/contact">Contact</a>

            </div>

        </nav>
    </header>
    <%- include('partials/signReg') %>

        <main class="user-feature-page">
            <div class="feature-page-header">
                <h2>Bookmarks</h2>
                <p class="muted">Articles you've bookmarked will appear here.</p>
            </div>

            <div class="feature-grid">
                <% if (!loggedIn) { %>
                    <div style="text-align: center; width: 100%; margin-top: 20px;">
                        <a class="hero-btn primary trigger-auth-modal" href="#">Sign In to View
                            Bookmarks</a>
                    </div>
                    <% } else if (bookmarks && bookmarks.length) { %>
                        <div class="list-view-grid">
                            <% bookmarks.forEach(b=> { %>
                                <div class="blogs-card list-view-card">
                                    <div class="img-blog">
                                        <img src="<%= b.imageUrl || '/image/default-blog.jpg' %>" alt="<%= b.title %>">
                                    </div>
                                    <a href="/blog/<%= b.slug %>" class="card-link">
                                        <div class="blog-card-content">
                                            <span class="blog-category">
                                                <%= b.category || 'General' %>
                                            </span>
                                            <h2 class="blog-title">
                                                <%= b.title %>
                                            </h2>
                                            <p class="blog-excerpt">
                                                <%= b.metaDescription %>
                                            </p>
                                            <div class="blog-footer">
                                                <span class="blog-date">
                                                    <%= b.Date ? b.Date.toDateString() : '' %>
                                                </span>
                                                <a href="/blog/<%= b.slug %>" class="read-more-myblog">Read Article
                                                    →</a>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="empty-feature-state">
                                <h3>No bookmarks yet.</h3>
                                <p>Explore our articles and bookmark your favorites!</p>
                                <a href="/blog" class="hero-btn primary">Explore Articles</a>
                            </div>
                            <% } %>
            </div>
        </main>

        <footer class="footer">
            <div class="footer-wrapper">

                <div class="f-col brand">
                    <div class="logo">
                        <img src="/image/logo.png" alt="logo-image" class="logo-image">
                        <a href="/">
                            <h2>Saniova</h2>
                        </a>
                    </div>
                    <p>Your hub for tech insights, blogs and futuristic ideas.</p>
                </div>

                <div class="f-col">
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/blog">Blogs</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/privacy-policy">Privacy</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Community</h4>
                    <ul>
                        <li><a href="https://www.facebook.com/share/1HMvQ11zft/">Facebook</a></li>
                        <li><a href="https://www.reddit.com/u/WerewolfMain3182/s/i6biQC9A6T">Reddit</a></li>
                        <li><a
                                href="https://www.quora.com/profile/Saniova?ch=10&oid=3168548346&share=f830d026&srid=5a8iLI&target_type=user">quora</a>
                        </li>
                        <li><a href="https://pin.it/5b77ei5Rx">Pinterest</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/privacy-policy">Privacy Policy</a></li>
                        <li><a href="/terms-&-conditions">Terms & Conditions</a></li>
                        <li><a href="/disclaimer">Disclaimer</a></li>
                    </ul>
                </div>

            </div>

            <div class="footer-bottom">
                © 2025 Saniova — All rights reserved.
            </div>
        </footer>

        <script src="/script/authPopup.js"></script>
</body>

</html>