        <section class="home-sec">
            <div class="home-grid">
                <div class="hero-copy">
                    <span class="hero-badge">Future Trend Journal</span>
                    <h1>Discover AI-driven ideas and future tech stories.</h1>
                    <p>Curated insights on artificial intelligence, innovation, automation, and emerging digital trends
                        for the next generation of makers.</p>
                    <div class="hero-actions">
                        <a href="/blog" class="hero-btn primary">Explore Articles</a>
                        <a href="/contact" class="hero-btn secondary">Connect</a>
                    </div>
                </div>
                <div class="hero-visual" id="game-container">
                    <div class="hero-panel game-panel">
                        <div class="panel-top">
                            <span>FOCUS GRID</span>
                            <span class="panel-tag" id="gameStatusTag">READY</span>
                        </div>
                        <div class="panel-screen game-screen">
                            <!-- Start Screen -->
                            <div id="game-start-screen" class="game-overlay active">
                                <h3>Test Your Focus!</h3>
                                <p>Memorize the 1-16 grid layout in 17s, then click them in order as fast as possible.</p>
                                <button id="startGameBtn" class="hero-btn primary">Play Now</button>
                                <div id="startLeaderboardContainer" class="leaderboard-container">
                                    <p class="loading-text">Loading Leaderboard...</p>
                                </div>
                            </div>

                            <!-- Play Screen (Grid) -->
                            <div id="game-play-screen">
                                <div class="game-header">
                                    <div class="game-timer">Time: <span id="timerDisplay">0.0</span>s</div>
                                    <div class="game-stats">Errors: <span id="errorDisplay">0</span></div>
                                </div>
                                <div id="gameGrid" class="game-grid"></div>
                            </div>

                            <!-- End Screen -->
                            <div id="game-end-screen" class="game-overlay">
                                <h3>Game Over!</h3>
                                <div class="score-display">Score: <span id="finalScore" class="highlight">0</span></div>
                                <div class="time-display">Time: <span id="finalTime">0</span>s</div>
                                
                                <div id="leaderboardContainer" class="leaderboard-container">
                                    <!-- Leaderboard and Featured Blogs injected here via JS -->
                                    <p class="loading-text">Loading Leaderboard...</p>
                                </div>
                                <button id="restartGameBtn" class="hero-btn secondary">Play Again</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <section class="featured-sec">
            <div class="featured">
                <div style="background: url('<%= blog[featured].imageUrl %>')no-repeat center center; background-size: cover;
    overflow: hidden;
    object-fit: cover;" class="image">

                </div>
                <div class="desc">
                    <a href="/blog/<%= blog[featured].slug %>" class="card-link">
                        <div class="stories-style">
                            <p>Features Style</p>
                        </div>
                        <div class="title">
                            <h2>
                                <%= blog[featured].title %>
                            </h2>
                        </div>
                        <div class="blog-fp" id="featBlogDes">
                            <p>
                                <%= blog[featured].metaDescription %>
                            </p>
                        </div>
                        <a href="/blog/<%= blog[featured].slug %>"><button type="button" class="read-more">Read Full
                                Blog</button></a>
                    </a>
                </div>
            </div>
        </section>

        <div class="top-ads-wrapper" style="padding-top:10px ; margin-top: 0;">
        <div class="ad-container">
            <span class="ad-badge" style="top: auto; bottom: 0;transform: translateY(10%);">Advertisement</span>
            <div class="ad-scroll" id="ad-xy765-1">
                <iframe
                    src="/ads/banner728"
                    width="728"
                    height="90"
                    frameborder="0"
                    scrolling="no"
                    title="Advertisement">
                </iframe>
            </div>
            <div class="ad-scroll" id="ad-xy765-2">
                <iframe
                    src="/ads/banner468"
                    width="468"
                    height="60"
                    frameborder="0"
                    scrolling="no"
                    title="Advertisement">
                </iframe>
            </div>
            <div class="ad-scroll" id="ad-xy765-3">
                <iframe
                    src="/ads/banner320"
                    width="320"
                    height="50"
                    frameborder="0"
                    scrolling="no"
                    title="Advertisement">
                </iframe>
            </div>
        </div>
    </div>

        <section class="blog-sec">
            <div id="article-upper">
                <h3>Latest Articles</h3>
                <a href="/blog"><button type="button" class="read-more">All Posts-></button></a>
            </div>

            <% const groupedBlogs={}; blog.forEach(b=> {
                if (!groupedBlogs[b.category]) groupedBlogs[b.category] = [];
                groupedBlogs[b.category].push(b);
                });
                const categories = Object.keys(groupedBlogs).sort((a,b) => {
                if (a === 'Future Trends') return -1;
                if (b === 'Future Trends') return 1;
                return a.localeCompare(b);
                });
                %>

                <% categories.forEach(cat=> { %>
                    <div class="category-section">
                        <h4 class="category-title">
                            <%= cat %>
                        </h4>
                        <div class="blog-cards-grid">
                            <% groupedBlogs[cat].slice(0, 6).forEach(b=> { %>
                                <div class="blogs-card">
                                    <div class="img-blog">
                                        <img src="<%= b.imageUrl %>" alt="<%= b.title %>">
                                    </div>
                                    <a href="/blog/<%= b.slug %>" class="card-link">
                                        <div class="blog-card-content">
                                            <span class="blog-category">
                                                <%= b.category %>
                                            </span>

                                            <h2 class="blog-title">
                                                <%= b.title %>
                                            </h2>

                                            <p class="blog-excerpt">
                                                <%= b.metaDescription %>
                                            </p>

                                            <div class="blog-footer">
                                                <span class="blog-date">
                                                    <%= b.Date.toDateString() %>
                                                </span>
                                                <a href="/blog/<%= b.slug %>" class="read-more-myblog">Read Article
                                                    →</a>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                    <% }); %>
        </section>

        <section class="feedback-sec">
            <div class="feedback">
                <form action="/feedback" method="post">
                    <div class="fullN">
                        <div class="partN">

                            <label for="firstname">First Name</label>
                            <input type="text" name="firstName" id="firstname">
                        </div>
                        <div class="partN">

                            <label for="lastname">Last Name</label>
                            <input type="text" name="lastName" id="lastname">
                        </div>
                    </div>

                    <div class="form-ele">

                        <label for="emailadd">Email</label>
                        <input type="email" name="email" id="emailadd">
                    </div>

                    <div class="form-ele">

                        <label for="msg">Leave us a message...</label>
                        <textarea name="message" id="msg"></textarea>

                    </div>

                    <div class="form-ele">
                        <button type="submit" class="submit">Submit</button>
                    </div>

                </form>
            </div>
        </section>

        <footer class="footer">
            <div class="footer-wrapper">

                <div class="f-col brand">
                    <div class="logo">
                        <img src="/image/logo.png" alt="logo-image" class="logo-image">
                        <a href="/">
                            <h2>Saniova</h2>
                        </a>
                    </div>
                    <p>Your hub for tech insights, blogs and futuristic ideas.</p>
                </div>

                <div class="f-col">
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/blog">Blogs</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/privacy-policy">Privacy</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Community</h4>
                    <ul>
                        <li><a href="https://www.facebook.com/share/1HMvQ11zft/">Facebook</a></li>
                        <li><a href="https://www.reddit.com/u/WerewolfMain3182/s/i6biQC9A6T">Reddit</a></li>
                        <li><a
                                href="https://www.quora.com/profile/Saniova?ch=10&oid=3168548346&share=f830d026&srid=5a8iLI&target_type=user">quora</a>
                        </li>
                        <li><a href="https://pin.it/5b77ei5Rx">Pinterest</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/privacy-policy">Privacy Policy</a></li>
                        <li><a href="/terms-&-conditions">Terms & Conditions</a></li>
                        <li><a href="/disclaimer">Disclaimer</a></li>
                    </ul>
                </div>

            </div>

            <div class="footer-bottom">
                © 2025 Saniova — All rights reserved.
            </div>
        </footer>
