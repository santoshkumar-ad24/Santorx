    </header>
    <%- include('partials/signReg') %>
    
    <div class="top-ads-wrapper">
        <div class="ad-container">
            <span class="ad-badge">Advertisement</span>
            <div class="ad-scroll" id="ad-xy765-1">
                <iframe
                    src="/ads/banner728"
