<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saniova | Create Blog</title>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheet/createBlog.css">
</head>

<body>
    <header>
        <nav>
            <div class="logo">
                <img src="/image/logo.png" alt="logo-image" class="logo-image">
                <h2>Saniova</h2>
            </div>
            <div class="header-actions">
                <a href="/admin/dashboard" class="back-btn"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
            </div>
        </nav>
    </header>

    <section class="create_blog">
        <h2 class="page-title">Create a New Post</h2>
        
        <form class="create-blog-form" action="/admin/postBlog" method="POST">
            
            <!-- Left Column: Main Editor -->
            <div class="main-editor-area">
                <input type="text" id="title" name="title" class="title-input" placeholder="Enter an engaging title..." required>
                
                <div class="editor-container">
                    <div id="editor"></div>
                </div>
                
                <!-- Hidden inputs for form submission -->
                <textarea hidden id="content" name="content"></textarea>
                <input type="hidden" name="image" id="imageUrl" value="null">
            </div>

            <!-- Right Column: Settings & Metadata -->
            <div class="sidebar-settings-area">
                
                <div class="form-group">
                    <label for="category">Category</label>
                    <select id="category" name="category" class="setting-select" required>
                        <option>AI Trends & Future</option>
                        <option>Tools & Reviews</option>
                        <option>Creators & Marketing</option>
                        <option>Productivity & Automation</option>
                    </select>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="featured" name="featured" value="true">
                    <label for="featured">Featured Post</label>
                </div>

                <div class="form-group">
                    <label for="description">Meta Description</label>
                    <textarea id="description" name="description" class="setting-textarea" placeholder="A brief summary for search engines and preview cards..." required></textarea>
                </div>

                <div class="form-group">
                    <label for="keyword">Keywords (SEO)</label>
                    <textarea id="keyword" name="keyword" class="setting-textarea" placeholder="AI, innovation, technology..." required></textarea>
                </div>

                <button type="submit" class="submit-btn" id="publish">
                    <i class="fas fa-paper-plane"></i> Publish Now
                </button>
                
            </div>
            
        </form>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="/script/quilleditor.js"></script>
</body>

</html>