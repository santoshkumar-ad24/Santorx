    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="History - Saniova. Learn how we protect your data while exploring AI, AGI, and future technology insights.">
    <meta name="keywords" content="History, Data Protection, AI Technology, Saniova, AGI, Future Tech">
    <meta property="og:site_name" content="Saniova" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <title>Check History | Saniova</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="/stylesheet/hamburger-menu.css">
    <link rel="stylesheet" href="/stylesheet/blog-cards.css">
</head>

<body>
    <header>
        <nav>
            <div class="logo">
                <img src="/image/logo.png" alt="logo-image" class="logo-image">
                <a href="/">
                    <h2>Saniova</h2>
                </a>
            </div>
            <input type="checkbox" id="menu-toggle" style="display: none;">
            <label for="menu-toggle" class="menu-backdrop" aria-hidden="true"></label>
            <label for="menu-toggle" class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div class="nav-link menu">
                <a href="/">Home</a>
                <a href="/blog">Blog</a>
                <a href="/about">About</a>
                <a href="/privacy-policy">Privacy</a>
                <a href="/contact">Contact</a>

            </div>

        </nav>
    </header>
    <%- include('partials/signReg') %>

        <main class="user-feature-page">
            <div class="feature-page-header">
                <h2>History</h2>
                <p class="muted">Your recently viewed articles.</p>
                <% if (loggedIn && history && history.length> 0) { %>
                    <button class="clear-history-btn" id="clearAllHistoryBtn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                            </path>
                            <line x1="10" y1="11" x2="10" y2="17"></line>
                            <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                        Clear All
                    </button>
                    <% } %>
            </div>

            <div class="feature-grid">
                <% if (!loggedIn) { %>
                    <div style="text-align: center; width: 100%; margin-top: 20px;">
                        <a class="hero-btn primary trigger-auth-modal" href="#">Sign In to View
                            History</a>
                    </div>
                    <% } else if (history && history.length) { %>

                        <div class="list-view-grid">
                            <% history.forEach(h=> { %>
                                <div class="blogs-card list-view-card">
                                    <div class="img-blog">
                                        <img src="<%= h.imageUrl || '/image/default-blog.jpg' %>" alt="<%= h.title %>">
                                    </div>
                                    <a href="/blog/<%= h.slug %>" class="card-link">
                                        <div class="blog-card-content">
                                            <span class="blog-category">
                                                <%= h.category || 'General' %>
                                            </span>
                                            <h2 class="blog-title">
                                                <%= h.title %>
                                            </h2>
                                            <p class="blog-excerpt">
                                                <%= h.metaDescription %>
                                            </p>
                                            <div class="blog-footer">
                                                <span class="blog-date">
                                                    Viewed: <%= h.viewedAt ? new Date(h.viewedAt).toDateString() :
                                                        (h.Date ? h.Date.toDateString() : '' ) %>
                                                </span>
                                                <div class="card-actions">
                                                    <button class="delete-history-btn" data-blog-id="<%= h._id %>"
                                                        title="Remove from history">
                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2"
                                                            stroke-linecap="round" stroke-linejoin="round">
                                                            <polyline points="3 6 5 6 21 6"></polyline>
                                                            <path
                                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                            </path>
                                                        </svg>
                                                    </button>
                                                    <a href="/blog/<%= h.slug %>" class="read-more-myblog">Read Article
                                                        →</a>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="empty-feature-state">
                                <h3>No history yet.</h3>
                                <p>Start reading some articles to build your history!</p>
                                <a href="/blog" class="hero-btn primary">Explore Articles</a>
                            </div>
                            <% } %>
            </div>
        </main>

        <footer class="footer">
            <div class="footer-wrapper">

                <div class="f-col brand">
                    <div class="logo">
                        <img src="/image/logo.png" alt="logo-image" class="logo-image">
                        <a href="/">
                            <h2>Saniova</h2>
                        </a>
                    </div>
                    <p>Your hub for tech insights, blogs and futuristic ideas.</p>
                </div>

                <div class="f-col">
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/blog">Blogs</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/privacy-policy">Privacy</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Community</h4>
                    <ul>
                        <li><a href="https://www.facebook.com/share/1HMvQ11zft/">Facebook</a></li>
                        <li><a href="https://www.reddit.com/u/WerewolfMain3182/s/i6biQC9A6T">Reddit</a></li>
                        <li><a
                                href="https://www.quora.com/profile/Saniova?ch=10&oid=3168548346&share=f830d026&srid=5a8iLI&target_type=user">quora</a>
                        </li>
                        <li><a href="https://pin.it/5b77ei5Rx">Pinterest</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/privacy-policy">Privacy Policy</a></li>
                        <li><a href="/terms-&-conditions">Terms & Conditions</a></li>
                        <li><a href="/disclaimer">Disclaimer</a></li>
                    </ul>
                </div>

            </div>

            <div class="footer-bottom">
                © 2025 Saniova — All rights reserved.
            </div>
        </footer>

        <%- include('partials/confirmModal') %>
            <script src="/script/authPopup.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const clearBtn = document.getElementById('clearAllHistoryBtn');
                    if (clearBtn) {
                        clearBtn.addEventListener('click', async () => {
                            const confirmed = await window.customConfirm(
                                'Clear History',
                                'Are you sure you want to clear your entire reading history?',
                                'Clear All'
                            );
                            if (!confirmed) return;

                            try {
                                const response = await fetch('/history', {
                                    method: 'DELETE',
                                    headers: { 'Content-Type': 'application/json' }
                                });
                                const data = await response.json();
                                if (data.success) {
                                    window.location.reload();
                                } else {
                                    alert('Error clearing history: ' + (data.message || 'Unknown error'));
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Error clearing history');
                            }
                        });
                    }

                    const deleteBtns = document.querySelectorAll('.delete-history-btn');
                    deleteBtns.forEach(btn => {
                        btn.addEventListener('click', async (e) => {
                            e.preventDefault();
                            const blogId = btn.getAttribute('data-blog-id');

                            const confirmed = await window.customConfirm(
                                'Remove Item',
                                'Remove this article from your history?'
                            );
                            if (!confirmed) return;

                            try {
                                const response = await fetch(`/history/${blogId}`, {
                                    method: 'DELETE',
                                    headers: { 'Content-Type': 'application/json' }
                                });
                                const data = await response.json();
                                if (data.success) {
                                    window.location.reload();
                                } else {
                                    alert('Error removing item: ' + (data.message || 'Unknown error'));
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Error removing item from history');
                            }
                        });
                    });
                });
            </script>
</body>

</html>