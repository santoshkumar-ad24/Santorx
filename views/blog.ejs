<!DOCTYPE html>
<html lang="en">

<head>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q1SH5LZCTH"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-Q1SH5LZCTH');
    </script>
    <script type="application/ld+json">
{
"@context": "https://schema.org",
"@type": "WebSite",
"name": "Saniova"
}
</script>
    <meta name="yandex-verification" content="dad153b32c9fed72" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= blog.metaDescription %>">
    <meta name="keywords" content="<%= blog.metaKeywords %>">
    <meta name="author" content="<%= blog.adminId.adminName %>">
    <meta property="og:title" content="<%= blog.title %>" />
    <meta property="og:description" content="<%= blog.metaDescription %>" />
    <meta property="og:image" content="<%= blog.imageUrl %>" />
    <meta property="og:url" content="https://rsantosh.com.np/blog/<%= blog.slug %>" />
    <meta property="og:type" content="article" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= blog.title %>" />
    <meta name="twitter:description" content="<%= blog.metaDescription %>" />
    <meta name="twitter:image" content="<%= blog.imageUrl %>" />
    <meta name="twitter:url" content="https://rsantosh.com.np/blog/<%= blog.slug %>" />

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <title>
        <%= blog.title %> | Saniova
    </title>

    <script type="application/ld+json">
{
 "@context": "https://schema.org",
 "@type": "Article",
 "headline": "<%= blog.title %>",
 "description": "<%= blog.metaDescription %>",
 "image": "<%= blog.imageUrl %>",
 "author": {
   "@type": "Person",
   "name": "Santosh Gupta"
 },
 "publisher": {
   "@type": "Organization",
   "name": "Saniova"
 },
 "datePublished": "<%= blog.createdAt %>",
 "dateModified": "<%= blog.updatedAt %>"
}
</script>


    <script type="application/ld+json">
{
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": [{
   "@type": "ListItem",
   "position": 1,
   "name": "Home",
   "item": "https://rsantosh.com.np"
 },{
   "@type": "ListItem",
   "position": 2,
   "name": "Blog",
   "item": "https://rsantosh.com.np/blog"
 },{
   "@type": "ListItem",
   "position": 3,
   "name": "<%= blog.title %>",
   "item": "https://rsantosh.com.np/blog/<%= blog.slug %>"
 }]
}
</script>
    <script type="text/javascript">
        (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "w0boasx8gf");
    </script>
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Chelsea+Market&family=DM+Serif+Text:ital@0;1&family=Funnel+Sans:ital,wght@0,300..800;1,300..800&display=swap">

    <noscript>
        <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Chelsea+Market&family=DM+Serif+Text:ital@0;1&family=Funnel+Sans:ital,wght@0,300..800;1,300..800&display=swap">
    </noscript>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="/stylesheet/blog.css">
    <link rel="stylesheet" href="/stylesheet/hamburger-menu.css">
</head>

<body>
    <header>
        <nav>

            <div class="logo">
                <img src="/image/logo.png" alt="logo-image" class="logo-image">
                <a href="/">
                    <h2>Saniova</h2>
                </a>
            </div>
            <input type="checkbox" id="menu-toggle" style="display: none;">
            <label for="menu-toggle" class="menu-backdrop" aria-hidden="true"></label>
            <label for="menu-toggle" class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div class="nav-link menu">
                <a href="/">Home</a>
                <a href="/blog">Blog</a>
                <a href="/about">About</a>
                <a href="/privacy-policy">Privacy</a>
                <a href="/contact">Contact</a>
            </div>

        </nav>

    </header>
    <%- include('partials/signReg') %>


        <main>

            <section class="blogSec">
                <article>
                    <!-- Hero Section with Title -->
                    <div class="blog-hero">
                        <h1 class="blog-title">
                            <%= blog.title %>
                        </h1>

                        <!-- Author & Date Card -->
                        <div class="uploader">
                            <div class="uploader-img">
                                <img src="<%= blog.adminId.adminImage %>" alt="admin-profile-image" width="60"
                                    height="60">
                            </div>
                            <div id="uploader-details">
                                <div class="uploader-det">
                                    <p id="uploader-name">
                                        <%= blog.adminId.adminName %>
                                    </p>
                                    <p id="uploader-date">
                                        <%= blog.Date.toDateString() %>
                                    </p>
                                </div>
                                <div class="blog-meta">
                                    <span class="read-time">📖 5 min read</span>
                                </div>
                            </div>
                        </div>
                    </div>



                    <!-- Main Content Section -->
                    <div class="blog-container">

                        <aside class="share-aside">
                            <div class="blog-interact">
                                <div class="interact-actions">
                                    <button type="button" class="interact-btn like trigger-auth-modal"
                                        data-action="like" aria-label="Like article">
                                        <span class="icon"><img class="blog-interact-icon" src="/image/like-icon.png"
                                                alt="like"></span>
                                        <span class="count"></span>
                                    </button>
                                    <button type="button" class="interact-btn dislike trigger-auth-modal"
                                        data-action="dislike" aria-label="Dislike article">
                                        <span class="icon"><img class="blog-interact-icon" src="/image/dislike.png"
                                                alt="dislike"></span>
                                    </button>
                                    <button type="button" class="interact-btn comment" aria-label="Comment article">
                                        <span class="icon"><img class="blog-interact-icon" src="/image/comment-icon.png"
                                                alt="comment"></span>
                                        <span class="count"></span>
                                    </button>

                                    <div class="bookmark-action-blog">
                                        <% if (locals.user) { %>
                                            <form method="POST" action="/bookmarks/toggle/<%= blog.slug %>"
                                                class="ajax-bookmark-form">
                                                <button type="submit" class="interact-btn bookmark bookmark-btn"
                                                    aria-label="<%= locals.isBookmarked ? 'Remove bookmark' : 'Bookmark article' %>">
                                                    <span class="book-icon"><%- locals.isBookmarked
                                                            ? '<img class="blog-interact-icon" src="/image/saved-icon.png" alt="saved">'
                                                            : '<img class="blog-interact-icon" src="/image/bookmark-icon.png" alt="bookmark">'
                                                            %></span>
                                                </button>
                                            </form>
                                            <% } else { %>
                                                <button type="button" class="interact-btn bookmark trigger-auth-modal"
                                                    data-action="bookmark" aria-label="Bookmark article">
                                                    <span class="icon"><img class="blog-interact-icon"
                                                            src="/image/bookmark-icon.png" alt="bookmark"></span>
                                                </button>
                                                <% } %>
                                    </div>
                                </div>
                            </div>
                            <!-- Share Section -->
                            <div class="share-section">
                                <button type="button" class="share-toggle-btn share0toggle-icon" aria-expanded="false"
                                    aria-controls="share-options" aria-label="Toggle share options">
                                    <span class="share-toggle-icon"><img class="blog-interact-icon"
                                            src="/image/share-icon.png" alt="share"></span>
                                </button>
                                <div class="share-panel" id="share-options" aria-hidden="true">
                                    <div class="share-buttons">
                                        <a href="#" id="shareBtn-facebook" class="share-btn facebook"
                                            title="Share on Facebook">f</a>
                                        <a href="#" id="shareBtn-twitter" class="share-btn twitter"
                                            title="Share on Twitter">𝕏</a>
                                        <a href="#" id="shareBtn-linkedin" class="share-btn linkedin"
                                            title="Share on LinkedIn">in</a>
                                        <a href="#" id="copyLinkBtn" class="share-btn copy" title="Copy Link">🔗</a>
                                    </div>
                                </div>
                            </div>
                        </aside>
                        <!-- Main Content -->


                        <div class="content-container">
                            <!-- Featured Image with Shadow -->
                            <div class="contentImg">
                                <img src="<%= blog.imageUrl %>" alt="<%= blog.slug %>" loading="lazy">
                            </div>

                            <!-- Blog Body Content -->
                            <div class="content">
                                <p>
                                    <%- blog.content %>
                                </p>
                            </div>


                        </div>


                        <!-- Sidebar -->
                    </div>

                    <!-- Comments Slide Panel -->
                    <div class="comment-panel" id="commentPanel" data-blog-slug="<%= blog.slug %>">
                        <div class="comment-panel-header">
                            <h3 class="comments-title">💬 Comments</h3>
                            <button class="comment-close-btn" aria-label="Close comments">×</button>
                        </div>
                        <div class="comment-form">
                            <div class="comment-input-wrapper">
                                <% if (locals.user) { %>
                                    <div class="comment-avatar-container">
                                        <img class="comment-user-avatar" src="<%= user.profileImage %>"
                                            alt="User Avatar">
                                    </div>
                                    <% } else { %>
                                        <div class="comment-avatar-container">
                                            <img class="comment-user-avatar" src="/image/avatar-sign.png"
                                                alt="Guest Avatar">
                                        </div>
                                        <% } %>
                                            <div class="comment-input-box">
                                                <textarea class="comment-input" placeholder="Share your thoughts..."
                                                    maxlength="1000" rows="4"></textarea>
                                                <div class="comment-action-row">
                                                    <% if (!locals.user) { %>
                                                        <button class="comment-signin-btn" type="button">Sign
                                                            In</button>
                                                        <% } else { %>
                                                            <button class="comment-submit-btn"
                                                                type="button">Post</button>
                                                            <% } %>
                                                </div>
                                            </div>
                            </div>
                        </div>
                        <div class="comments-list"></div>
                    </div>

                    <section class="blog-recommendation">

                        <!-- Recommended Posts -->
                        <div class="blogList-container">
                            <h3 class="recommended-title">Recommended Posts</h3>

                            <!-- <div class="blog-reco-box"> -->
                            <div class="box-reco-blog">
                                <% let featuredBlog; do { featuredBlog=Math.floor(Math.random() * blogList.length); }
                                    while (blogList[featuredBlog].slug===blogSlug); %>

                                    <div class="blogList1">
                                        <a href="/blog/<%= blogList[featuredBlog].slug %>" class="featured-blog-post">
                                            <div class="feat-reco-image">
                                                <img src="<%= blogList[featuredBlog].imageUrl %>"
                                                    alt="<%= blogList[featuredBlog].slug %>" loading=" lazy">
                                            </div>
                                            <div class="feat-blogList-details">
                                                <p class="feat-blogList-title">
                                                    <%= blogList[featuredBlog].title %>
                                                </p>
                                            </div>
                                        </a>
                                    </div>

                                    <% totalBlog=8; for( let index=0; index < Math.min(blogList.length ,totalBlog);
                                        index++ ) { if(index===featuredBlog){ totalBlog=totalBlog + 1; continue; } %>
                                        <div class="blogList">
                                            <a href="/blog/<%= blogList[index].slug %>" class="blog-post">
                                                <div class="reco-image">
                                                    <img src="<%= blogList[index].imageUrl %>"
                                                        alt="<%= blogList[index].slug %>" loading=" lazy">
                                                    loading="lazy">
                                                </div>
                                                <div class="blogList-details">
                                                    <p class="blogList-title">
                                                        <%= blogList[index].title %>
                                                    </p>
                                                    <p class="blogList-des" id="featBlogDes">
                                                        <%= blogList[index].metaDescription %>
                                                    </p>
                                                </div>
                                            </a>
                                        </div>
                                        <% } %>
                            </div>


                    </section>
                </article>

        </main>
        <footer class="footer">
            <div class="footer-wrapper">

                <div class="f-col brand">
                    <div class="logo">
                        <img src="/image/logo.png" alt="logo-image" class="logo-image">
                        <a href="/">
                            <h2>Saniova</h2>
                        </a>
                    </div>
                    <p>Your hub for tech insights, blogs and futuristic ideas.</p>
                </div>

                <div class="f-col">
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/blog">Blogs</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Community</h4>
                    <ul>
                        <li><a href="https://www.facebook.com/share/1HMvQ11zft/">Facebook</a></li>
                        <li><a href="https://www.reddit.com/u/WerewolfMain3182/s/i6biQC9A6T">Reddit</a></li>
                        <li><a
                                href="https://www.quora.com/profile/Saniova?ch=10&oid=3168548346&share=f830d026&srid=5a8iLI&target_type=user">quora</a>
                        </li>
                        <li><a href="https://pin.it/5b77ei5Rx">Pinterest</a></li>
                    </ul>
                </div>

                <div class="f-col">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/privacy-policy">Privacy Policy</a></li>
                        <li><a href="/terms-&-conditions">Terms & Conditions</a></li>
                        <li><a href="/disclaimer">Disclaimer</a></li>
                    </ul>
                </div>

            </div>

            <div class="footer-bottom">
                © 2025 Saniova — All rights reserved.
            </div>
        </footer>


        <%- include('partials/confirmModal') %>
            <script src="/script/share.js"></script>
            <script src="/script/blog-interactions.js"></script>
            <script src="/script/blogdescriptional.js"></script>
            <script src="/script/authPopup.js"></script>
</body>

</html>